{
  "name": "obsidian-card-wall",
  "version": "0.1.1",
  "description": "A Bases view that shows notes as a packed wall of cards, with drag-to-reorder, pins and colors",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "Koki Muraoka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmu/obsidian-card-wall.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bases",
    "cards",
    "masonry"
  ]
}
